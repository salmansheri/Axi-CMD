<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <AxRuntimePath Condition="'$(AxRuntimePath)' == ''">$(MSBuildProjectDirectory)/../../ARMMICRO/AxPlugins/AxExtend</AxRuntimePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.25" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" PrivateAssets="all" />
    <ProjectReference Include="../AxiApi/AxiApi.csproj" />
    <Reference Include="ARMCommon"><HintPath>$(AxRuntimePath)/ARMCommon.dll</HintPath></Reference>
    <Reference Include="AxExtend"><HintPath>$(AxRuntimePath)/AxExtend.dll</HintPath></Reference>
  </ItemGroup>
</Project>
